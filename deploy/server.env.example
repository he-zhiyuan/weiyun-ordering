# /etc/sky-take-out/server.env 的完整模板
# 部署到新服务器时：
#   1. mkdir -p /etc/sky-take-out
#   2. 把本文件复制为 /etc/sky-take-out/server.env
#   3. 填入真实值（不要把填好的文件提交进 git，该路径由 systemd 的 EnvironmentFile= 读取，不在仓库管理范围内）
#
# 对应关系：SKY_DATASOURCE_HOST -> application.yml 里的 ${sky.datasource.host}
# Spring Boot 会用同名（松绑定规则：全大写+下划线）的环境变量覆盖 application.yml 里的占位符，
# 这是 Spring Boot 内置的 PropertySource 优先级机制，不需要任何额外配置。

SPRING_PROFILES_ACTIVE=dev

# ------ 必填：MySQL 数据源 ------
SKY_DATASOURCE_HOST=
SKY_DATASOURCE_PORT=3306
SKY_DATASOURCE_DATABASE=
SKY_DATASOURCE_USERNAME=
SKY_DATASOURCE_PASSWORD=

# ------ 必填：Redis ------
SKY_REDIS_HOST=
SKY_REDIS_PORT=6379
SKY_REDIS_PASSWORD=
SKY_REDIS_DATABASE=0

# ------ 可选：阿里云 OSS（菜品图片上传）。留空则该功能不可用，但不影响启动和点餐主流程 ------
SKY_ALIOSS_ENDPOINT=
SKY_ALIOSS_ACCESS_KEY_ID=
SKY_ALIOSS_ACCESS_KEY_SECRET=
SKY_ALIOSS_BUCKET_NAME=

# ------ 可选：微信支付。留空则支付功能不可用，但不影响启动和点餐主流程 ------
SKY_WECHAT_APPID=
SKY_WECHAT_SECRET=
SKY_WECHAT_MCHID=
SKY_WECHAT_MCHSERIALNO=
SKY_WECHAT_PRIVATEKEYFILEPATH=
SKY_WECHAT_APIV3KEY=
SKY_WECHAT_WECHATPAYCERTFILEPATH=
SKY_WECHAT_NOTIFYURL=
SKY_WECHAT_REFUNDNOTIFYURL=
